(version 1)
(rule "Normal copper setback" (constraint edge_clearance (min 0.2mm)))
(rule "Intentional castellated header copper" (condition "A.memberOfFootprint('H*') || B.memberOfFootprint('H*')") (constraint edge_clearance (min 0mm)))
(rule "SMD pad spacing" (condition "A.Type == 'Pad' && B.Type == 'Pad' && A.Pad_Type == 'SMD' && B.Pad_Type == 'SMD'") (constraint clearance (min 0.15mm)))
